rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isSuperAdmin() {
      return signedIn()
        && currentUser().data.role == "super_admin"
        && currentUser().data.status == "active";
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "admin"
        && currentUser().data.status == "active";
    }

    function isGroupAdmin(groupId) {
      return isAdmin()
        && request.auth.uid in get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.adminIds;
    }

    match /users/{userId} {

      allow read: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        )
        || (
          isAdmin()
          && request.auth.uid in resource.data.adminIds
        );

      // Public registration creates an Admin account only.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "admin"
        && request.resource.data.status == "active"
        && request.resource.data.groupIds.size() == 0
        && request.resource.data.adminIds.size() == 0
        && request.resource.data.email == request.auth.token.email;

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.groupIds == resource.data.groupIds
          && request.resource.data.adminIds == resource.data.adminIds
        );

      allow delete: if isSuperAdmin();
    }

    match /groups/{groupId} {

      // Super Admin sees every group.
      // Admin sees only groups where they are listed in adminIds.
      allow read: if isSuperAdmin()
        || isGroupAdmin(groupId);

      // Super Admin can create any group.
      //
      // Admin can create a group only when:
      // - the creator is an active Admin
      // - the creator is included in adminIds
      // - the group creator matches the authenticated Admin
      allow create: if isSuperAdmin()
        || (
          isAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.adminIds
        );

      // Only Super Admin can change group ownership/admin assignment.
      //
      // An Admin can update normal group information only
      // for a group they already manage.
      allow update: if isSuperAdmin()
        || (
          isGroupAdmin(groupId)
          && request.resource.data.adminIds == resource.data.adminIds
          && request.resource.data.createdBy == resource.data.createdBy
        );

      allow delete: if isSuperAdmin()
        || isGroupAdmin(groupId);
    }

    match /group_admins/{membershipId} {

      // An Admin can see their own memberships.
      // Super Admin can see all memberships.
      allow read: if isSuperAdmin()
        || (
          isAdmin()
          && resource.data.adminId == request.auth.uid
        );

      // Super Admin can assign Admins to groups.
      //
      // A group Admin can also add another Admin to a group
      // that they manage.
      allow create: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(request.resource.data.groupId)
        );

      allow update, delete: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(resource.data.groupId)
        );
    }

    match /group_users/{membershipId} {

      allow read: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(resource.data.groupId)
        );

      // Only Super Admin or an Admin managing that group
      // can add a user.
      allow create: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(request.resource.data.groupId)
        );

      allow update, delete: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(resource.data.groupId)
        );
    }

    match /tasks/{taskId} {

      allow read: if isSuperAdmin()
        || isGroupAdmin(resource.data.groupId)
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow create: if isSuperAdmin()
        || isGroupAdmin(request.resource.data.groupId);

      allow update: if isSuperAdmin()
        || isGroupAdmin(resource.data.groupId)
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow delete: if isSuperAdmin()
        || isGroupAdmin(resource.data.groupId);
    }

    match /task_assignments/{assignmentId} {

      allow read: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAdmin()
          && isGroupAdmin(
            get(
              /databases/$(database)/documents/tasks/$(resource.data.taskId)
            ).data.groupId
          )
        );

      allow create: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(
            get(
              /databases/$(database)/documents/tasks/$(request.resource.data.taskId)
            ).data.groupId
          )
        )
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAdmin()
          && isGroupAdmin(
            get(
              /databases/$(database)/documents/tasks/$(resource.data.taskId)
            ).data.groupId
          )
        );

      allow delete: if isSuperAdmin()
        || (
          isAdmin()
          && isGroupAdmin(
            get(
              /databases/$(database)/documents/tasks/$(resource.data.taskId)
            ).data.groupId
          )
        );
    }

    match /notifications/{notificationId} {

      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSuperAdmin() || isAdmin();

      allow delete: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /activity_logs/{logId} {

      allow read: if isSuperAdmin();

      allow create: if signedIn();

      allow update, delete: if isSuperAdmin();
    }
  }
}
