rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "super_admin";
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isActiveAccount() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    function isGroupAdmin(groupId) {
      return isAdmin()
        && isActiveAccount()
        && exists(
          /databases/$(database)/documents/group_admins/$(groupId + "_" + request.auth.uid)
        );
    }

    match /users/{userId} {

      // Super Admin can read all profiles.
      // Users can read their own profile.
      // Admin access will be restricted further through group membership.
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid == userId)
        || isAdmin();

      // A newly registered account can create only its own
      // basic Admin profile.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "admin"
        && request.resource.data.status == "active"
        && request.resource.data.groupIds.size() == 0
        && request.resource.data.email == request.auth.token.email;

      // Super Admin can modify any profile.
      //
      // A user can modify only safe personal fields.
      // Role, status and group membership cannot be changed
      // by the account owner.
      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.groupIds == resource.data.groupIds
        );

      allow delete: if isSuperAdmin();
    }

    match /groups/{groupId} {

      allow read: if isSuperAdmin()
        || isGroupAdmin(groupId);

      // Only Super Admin creates groups.
      allow create: if isSuperAdmin();

      allow update, delete: if isSuperAdmin();
    }

    match /group_admins/{membershipId} {

      allow read: if isSuperAdmin() || isAdmin();

      // Only Super Admin assigns Admins to groups.
      allow create, update, delete: if isSuperAdmin();
    }

    match /group_users/{membershipId} {

      allow read: if isSuperAdmin() || isAdmin();

      // Admins can add users.
      allow create: if isSuperAdmin() || isAdmin();

      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /tasks/{taskId} {

      allow read: if isSuperAdmin()
        || isAdmin()
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow create: if isSuperAdmin() || isAdmin();

      allow update: if isSuperAdmin()
        || isAdmin()
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /task_assignments/{assignmentId} {

      allow read: if isSuperAdmin()
        || isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create, update: if isSuperAdmin()
        || isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /notifications/{notificationId} {

      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSuperAdmin() || isAdmin();

      allow delete: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /activity_logs/{logId} {

      allow read: if isSuperAdmin() || isAdmin();

      allow create: if signedIn();

      allow update, delete: if isSuperAdmin();
    }
  }
}
